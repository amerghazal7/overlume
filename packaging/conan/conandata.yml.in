# Generated by tools/release/render_vcpkg_conan.sh for overlume @VERSION@.
# sources[version][os][arch] -> url + sha256 of the release archive (macOS: universal2, both arches).
sources:
  "@VERSION@":
    Linux:
      x86_64:
        url: "@BASE_URL@/overlume-@VERSION@-linux-x86_64.tar.gz"
        sha256: "@SHA256_LINUX_X64@"
      armv8:
        url: "@BASE_URL@/overlume-@VERSION@-linux-aarch64.tar.gz"
        sha256: "@SHA256_LINUX_ARM64@"
    Macos:
      x86_64:
        url: "@BASE_URL@/overlume-@VERSION@-macos-universal.tar.gz"
        sha256: "@SHA256_MACOS@"
      armv8:
        url: "@BASE_URL@/overlume-@VERSION@-macos-universal.tar.gz"
        sha256: "@SHA256_MACOS@"
    Windows:
      x86_64:
        url: "@BASE_URL@/overlume-@VERSION@-windows-x64.zip"
        sha256: "@SHA256_WIN_X64@"
      armv8:
        url: "@BASE_URL@/overlume-@VERSION@-windows-arm64.zip"
        sha256: "@SHA256_WIN_ARM64@"
