  <groupId>io.github.amerghazal7</groupId>
  <artifactId>overlume</artifactId>
  <version>@VERSION@</version>
  <packaging>aar</packaging>
  <name>Overlume</name>
  <description>Real-time robot-scene rendering library (Filament) with a POD-only C API. Prefab package: native shared and static libraries for arm64-v8a, armeabi-v7a, x86_64 and x86.</description>
  <url>https://github.com/amerghazal7/overlume</url>
