      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>amerghazal7</id>
      <name>Amer Ghazal</name>
      <url>https://github.com/amerghazal7</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/amerghazal7/overlume.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/amerghazal7/overlume.git</developerConnection>
    <url>https://github.com/amerghazal7/overlume</url>
  </scm>
</project>
