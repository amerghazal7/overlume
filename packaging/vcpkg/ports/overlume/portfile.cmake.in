#
# Generated by tools/release/render_vcpkg_conan.sh for overlume @VERSION@.
# Binary port: installs the release archive for the target platform.

set(VCPKG_BUILD_TYPE release) # prebuilt release binaries only: no debug/ tree

# The Windows binaries are MSVC /MD: refuse MinGW and /MT (*-windows-static) here, at configure time,
# rather than letting the consumer fail at link time (also covers --allow-unsupported).
if(VCPKG_TARGET_IS_MINGW OR (VCPKG_TARGET_IS_WINDOWS AND VCPKG_CRT_LINKAGE STREQUAL "static"))
    message(FATAL_ERROR "overlume ships MSVC /MD binaries only: use ${VCPKG_TARGET_ARCHITECTURE}-windows (shared) "
        "or ${VCPKG_TARGET_ARCHITECTURE}-windows-static-md (static), not ${TARGET_TRIPLET}.")
endif()

if(VCPKG_TARGET_IS_WINDOWS AND VCPKG_TARGET_ARCHITECTURE STREQUAL "x64")
    set(archive "overlume-@VERSION@-windows-x64.zip")
    set(sha512 "@SHA512_WIN_X64@")
elseif(VCPKG_TARGET_IS_WINDOWS AND VCPKG_TARGET_ARCHITECTURE STREQUAL "arm64")
    set(archive "overlume-@VERSION@-windows-arm64.zip")
    set(sha512 "@SHA512_WIN_ARM64@")
elseif(VCPKG_TARGET_IS_OSX AND VCPKG_TARGET_ARCHITECTURE MATCHES "^(x64|arm64)$")
    set(archive "overlume-@VERSION@-macos-universal.tar.gz") # universal2: one archive for both
    set(sha512 "@SHA512_MACOS@")
elseif(VCPKG_TARGET_IS_LINUX AND VCPKG_TARGET_ARCHITECTURE STREQUAL "x64")
    set(archive "overlume-@VERSION@-linux-x86_64.tar.gz")
    set(sha512 "@SHA512_LINUX_X64@")
elseif(VCPKG_TARGET_IS_LINUX AND VCPKG_TARGET_ARCHITECTURE STREQUAL "arm64")
    set(archive "overlume-@VERSION@-linux-aarch64.tar.gz")
    set(sha512 "@SHA512_LINUX_ARM64@")
else()
    message(FATAL_ERROR "overlume has no prebuilt package for triplet ${TARGET_TRIPLET} "
        "(supported: x64/arm64 on windows, linux; x64/arm64 on osx).")
endif()

# Windows: the static-linkage triplets (x64-windows-static-md) take the static product.
# Linux/macOS triplets are static-linkage by default in vcpkg, but the Linux static product
# needs clang+libc++, so there it is opt-in through the "static" feature.
set(want_static OFF)
if("static" IN_LIST FEATURES OR (VCPKG_TARGET_IS_WINDOWS AND VCPKG_LIBRARY_LINKAGE STREQUAL "static"))
    set(want_static ON)
endif()

vcpkg_download_distfile(ARCHIVE
    URLS "@BASE_URL@/${archive}"
    FILENAME "${archive}"
    SHA512 "${sha512}")
# The Linux tar.gz has one top-level directory; the macOS and Windows archives are flat.
set(extract_options "")
if(NOT VCPKG_TARGET_IS_LINUX)
    set(extract_options NO_REMOVE_ONE_LEVEL)
endif()
vcpkg_extract_source_archive(SOURCE_PATH ARCHIVE "${ARCHIVE}" ${extract_options})

file(COPY "${SOURCE_PATH}/include" DESTINATION "${CURRENT_PACKAGES_DIR}")
file(COPY "${SOURCE_PATH}/share/overlume" DESTINATION "${CURRENT_PACKAGES_DIR}/share")
file(COPY "${SOURCE_PATH}/lib/cmake" DESTINATION "${CURRENT_PACKAGES_DIR}/lib")
if(EXISTS "${SOURCE_PATH}/share/pkgconfig")
    file(COPY "${SOURCE_PATH}/share/pkgconfig" DESTINATION "${CURRENT_PACKAGES_DIR}/share")
endif()

if(want_static)
    # The config only loads overlumeTargets.cmake (shared) when it exists.
    file(GLOB shared_cmake "${CURRENT_PACKAGES_DIR}/lib/cmake/overlume/overlumeTargets*.cmake")
    file(REMOVE ${shared_cmake})
    file(COPY "${SOURCE_PATH}/lib/overlume" DESTINATION "${CURRENT_PACKAGES_DIR}/lib")
    file(GLOB static_libs "${SOURCE_PATH}/lib/liboverlume.a" "${SOURCE_PATH}/lib/overlume_static.lib")
    file(COPY ${static_libs} DESTINATION "${CURRENT_PACKAGES_DIR}/lib")
elseif(VCPKG_TARGET_IS_WINDOWS)
    file(COPY "${SOURCE_PATH}/lib/overlume.lib" DESTINATION "${CURRENT_PACKAGES_DIR}/lib")
    # Only overlume.dll: the archive's bin/ also carries the VC++ redistributable DLLs.
    file(COPY "${SOURCE_PATH}/bin/overlume.dll" DESTINATION "${CURRENT_PACKAGES_DIR}/bin")
else()
    file(GLOB shared_libs "${SOURCE_PATH}/lib/liboverlume.so*" "${SOURCE_PATH}/lib/liboverlume*.dylib")
    file(COPY ${shared_libs} DESTINATION "${CURRENT_PACKAGES_DIR}/lib")
endif()
if(NOT want_static)
    # Static targets reference files this install does not carry.
    file(GLOB static_cmake "${CURRENT_PACKAGES_DIR}/lib/cmake/overlume/overlumeStaticTargets.cmake")
    file(REMOVE ${static_cmake})
endif()

# Prebuilt binaries: macOS ones are universal2 (vcpkg's per-triplet architecture check would reject
# them) and the Windows DLL is not built against vcpkg's CRT settings.
set(VCPKG_POLICY_SKIP_ARCHITECTURE_CHECK enabled)
if(VCPKG_TARGET_IS_WINDOWS)
    set(VCPKG_POLICY_SKIP_DUMPBIN_CHECKS enabled)
    set(VCPKG_POLICY_SKIP_CRT_LINKAGE_CHECK enabled)
endif()

vcpkg_cmake_config_fixup(PACKAGE_NAME overlume CONFIG_PATH lib/cmake/overlume)
# vcpkg_cmake_config_fixup rewrites the config/Targets prefix depth itself, but not the custom
# `_overlume_prefix` of overlumeStaticTargets.cmake (three levels up from lib/cmake/overlume;
# now two levels up from share/overlume).
if(want_static)
    vcpkg_replace_string("${CURRENT_PACKAGES_DIR}/share/overlume/overlumeStaticTargets.cmake"
        "\${CMAKE_CURRENT_LIST_DIR}/../../.." "\${CMAKE_CURRENT_LIST_DIR}/../..")
endif()

file(INSTALL "${SOURCE_PATH}/share/doc/overlume/LICENSE" DESTINATION "${CURRENT_PACKAGES_DIR}/share/${PORT}"
    RENAME copyright)
file(INSTALL "${CMAKE_CURRENT_LIST_DIR}/usage" DESTINATION "${CURRENT_PACKAGES_DIR}/share/${PORT}")
