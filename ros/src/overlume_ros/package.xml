<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>overlume_ros</name>
  <version>1.1.0</version>
  <description>ROS2 LifecycleNode wrapping overlume (Filament headless renderer) — Visual Mode (mode 3) on the /rendering/image mux.</description>
  <maintainer email="info@amerghazal.me">Amer Ghazal</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <!-- Ego TF adapter (Epic 1 Task 4 / VM-012): map to base_link lookup. The
       CMakeLists' find_package(tf2_ros) alone does not satisfy ament's
       package-dependency declaration, a missing depend tag here is a hard
       colcon_build.sh failure on a fresh/clean workspace even though a dev
       box that already has tf2_ros on CMAKE_PREFIX_PATH from a prior build
       may spuriously succeed without it. -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <!-- SetVirtualCam.srv (VM-095 cutover Step 4): owned by THIS package since
       the old node's retirement — rosidl generation plumbing below. -->
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- Epic 2 Task 1 (VM-020): profile YAML loader + the message types every
       profile row's `type:` and every later adapter need. Every
       find_package in CMakeLists.txt needs a matching depend tag here, per
       the hard-failure lesson already recorded on tf2/tf2_ros above. -->
  <depend>yaml_cpp_vendor</depend>
  <depend>visualization_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>map_msgs</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>ament_index_cpp</depend>
  <!-- Epic 3 Task 2 (VM-034): ~/diagnostics message type. ROS2 Humble core
       package, already present in this distro. -->
  <depend>diagnostic_msgs</depend>
  <!-- VM-091 (unified-engine migration Task 2 Step 6): camera_ingest.cpp's
       cv_bridge::toCvCopy(msg, "rgb8") call, the same dependency
       the retired CUDA node declared for the identical call. -->
  <depend>cv_bridge</depend>

  <!-- overlume (clang/libc++) is NOT a ROS package and cannot be
       add_subdirectory'd into this gcc/libstdc++ build (spec §2).
       CMakeLists.txt links it in one of two ways (OVERLUME_ROS_LINK): tree
       imports the prebuilt static lib from overlume/build/; system takes an
       installed overlume 1.1+ through find_package (the apt package). No
       rosdep entry applies to either. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <!-- test_ego_anchor.cpp (compose_ego_anchored_pose unit coverage). -->
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
