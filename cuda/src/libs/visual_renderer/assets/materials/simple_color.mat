// simple_color.mat — Epic 0 Task 2's hello-frame material.
//
// Why this exists instead of Engine::getDefaultMaterial(): the engine's
// built-in default material renders as a flat, fixed "80% white" regardless
// of scene lighting (confirmed empirically — zeroing every light in the
// scene produced pixel-identical output). That's fine for "prove something
// renders", but useless for telling the ground/grid/cube apart, which is
// what Step 4's "visually confirm cube+grid+horizon" needs. A real .mat is
// how every later epic's theme materials get authored anyway (see
// docs/superpowers/plans/2026-08-18-visual-mode.md Epic 1's
// dark_adas/light_clay theme YAMLs) — this is the smallest possible version
// of that: one unlit material with a per-instance baseColor parameter, so
// ground/grid/cube can each get a distinct, predictable, lighting-
// independent color instead of fighting the LIT pipeline for a spike.
material {
    name : "SimpleColor",
    shadingModel : unlit,
    parameters : [
        { type : float3, name : baseColor }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor.rgb = materialParams.baseColor;
    }
}
