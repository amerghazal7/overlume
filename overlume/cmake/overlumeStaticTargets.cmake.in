get_filename_component(_overlume_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
if(NOT TARGET overlume::overlume_static)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" AND NOT CMAKE_SYSTEM_NAME STREQUAL "Android")
        message(WARNING "overlume static on ${CMAKE_SYSTEM_NAME}: yaml-cpp/spdlog/cesium-native "
            "symbols are not renamed. Do not also link your own copies; prefer the shared component.")
    endif()
    add_library(overlume::overlume_static STATIC IMPORTED)
    set_target_properties(overlume::overlume_static PROPERTIES
        IMPORTED_LOCATION "${_overlume_prefix}/lib/liboverlume.a"
        IMPORTED_LINK_INTERFACE_LANGUAGES CXX
        INTERFACE_INCLUDE_DIRECTORIES "${_overlume_prefix}/include"
        INTERFACE_LINK_OPTIONS "@_overlume_static_link_options@"
        INTERFACE_LINK_LIBRARIES "@_overlume_static_link_libs@")
endif()
unset(_overlume_prefix)
