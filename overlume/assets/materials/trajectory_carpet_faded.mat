material {
    name : trajectory_carpet_faded,
    shadingModel : unlit,
    parameters : [
        { type : float, name : alpha }
    ],
    requires : [ color ],
    blending : fade
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        float alpha = materialParams.alpha * getColor().a;
        material.baseColor.rgb = getColor().rgb * alpha;
        material.baseColor.a = alpha;
    }
}
