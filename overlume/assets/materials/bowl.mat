material {
    name : bowl,
    shadingModel : unlit,
    parameters : [
        { type : sampler2d, name : camTex0 },
        { type : sampler2d, name : camTex1 },
        { type : sampler2d, name : camTex2 },
        { type : sampler2d, name : camTex3 },
        { type : sampler2d, name : camTex4 },
        { type : sampler2d, name : camTex5 },
        { type : float3, name : camRight0 },
        { type : float3, name : camFwd0 },
        { type : float3, name : camT0 },
        { type : float4, name : camK0 },
        { type : float4, name : camDist0 },
        { type : float, name : camK3_0 },
        { type : float3, name : camRight1 },
        { type : float3, name : camFwd1 },
        { type : float3, name : camT1 },
        { type : float4, name : camK1 },
        { type : float4, name : camDist1 },
        { type : float, name : camK3_1 },
        { type : float3, name : camRight2 },
        { type : float3, name : camFwd2 },
        { type : float3, name : camT2 },
        { type : float4, name : camK2 },
        { type : float4, name : camDist2 },
        { type : float, name : camK3_2 },
        { type : float3, name : camRight3 },
        { type : float3, name : camFwd3 },
        { type : float3, name : camT3 },
        { type : float4, name : camK3 },
        { type : float4, name : camDist3 },
        { type : float, name : camK3_3 },
        { type : float3, name : camRight4 },
        { type : float3, name : camFwd4 },
        { type : float3, name : camT4 },
        { type : float4, name : camK4 },
        { type : float4, name : camDist4 },
        { type : float, name : camK3_4 },
        { type : float3, name : camRight5 },
        { type : float3, name : camFwd5 },
        { type : float3, name : camT5 },
        { type : float4, name : camK5 },
        { type : float4, name : camDist5 },
        { type : float, name : camK3_5 },
        { type : float3, name : skyColor },
        { type : float, name : featherMargin },
        { type : float, name : exposureCompensation }
    ],
    requires : [ color, custom0, custom1 ],
    variables : [ custom0, custom2, custom3 ]
}
vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        material.custom0 = material.color;
        material.custom2 = vec4(getCustom0().xyz, 0.0);
        material.custom3 = vec4(getCustom1().xy, 0.0, 0.0);
    }
}
fragment {
    void addCam(sampler2D tex, vec3 right, vec3 fwd, vec3 t, vec4 K, vec4 dist, float k3,
                float coverage, vec3 rigPos, inout vec3 colorSum, inout float wsum) {
        if (coverage <= 0.0) return;
        vec3 down = cross(fwd, right);
        vec3 rel = rigPos - t;
        float zc = dot(fwd, rel);
        if (zc <= 1e-9) return;
        float xn = dot(right, rel) / zc;
        float yn = dot(down, rel) / zc;
        float k1 = dist.x;
        float k2 = dist.y;
        float p1 = dist.z;
        float p2 = dist.w;
        bool distorted = (k1 != 0.0 || k2 != 0.0 || p1 != 0.0 || p2 != 0.0 || k3 != 0.0);
        float r2 = xn * xn + yn * yn;
        if (distorted) {
            if (r2 > 3.0) return;
            float radial = 1.0 + r2 * (k1 + r2 * (k2 + r2 * k3));
            float xd = xn * radial + 2.0 * p1 * xn * yn + p2 * (r2 + 2.0 * xn * xn);
            float yd = yn * radial + p1 * (r2 + 2.0 * yn * yn) + 2.0 * p2 * xn * yn;
            xn = xd;
            yn = yd;
        }
        float fx = K.x;
        float fy = K.y;
        float cx = K.z;
        float cy = K.w;
        ivec2 dims = textureSize(tex, 0);
        float width = float(dims.x);
        float height = float(dims.y);
        float xp = fx * xn + cx;
        float yp = fy * yn + cy;
        if (xp < 0.0 || xp > width - 1.0 || yp < 0.0 || yp > height - 1.0) return;
        float d = min(min(xp, (width - 1.0) - xp), min(yp, (height - 1.0) - yp));
        float feather;
        if (materialParams.featherMargin <= 0.0) {
            feather = step(0.0, d);
        } else {
            float ratio = clamp(d / materialParams.featherMargin, 0.0, 1.0);
            feather = ratio * ratio * (3.0 - 2.0 * ratio);
        }
        float wgt = coverage * feather;
        if (wgt <= 0.0) return;
        vec2 uv = (vec2(xp, yp) + 0.5) / vec2(width, height);
        colorSum += wgt * texture(tex, uv).rgb;
        wsum += wgt;
    }

    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec4 c0 = variable_custom0;
        vec4 c1 = variable_custom3;
        vec3 rigPos = variable_custom2.xyz;
        float coverageA = c0.x;
        int idxA = int(c0.y + 0.5);
        float coverageB = c0.z;
        int idxB = int(c0.w + 0.5);
        float coverageC = c1.x;
        int idxC = int(c1.y + 0.5);

        vec3 colorSum = vec3(0.0);
        float wsum = 0.0;

        addCam(materialParams_camTex0, materialParams.camRight0, materialParams.camFwd0,
               materialParams.camT0, materialParams.camK0, materialParams.camDist0,
               materialParams.camK3_0,
               (idxA == 0) ? coverageA : ((idxB == 0) ? coverageB : ((idxC == 0) ? coverageC : 0.0)),
               rigPos, colorSum, wsum);
        addCam(materialParams_camTex1, materialParams.camRight1, materialParams.camFwd1,
               materialParams.camT1, materialParams.camK1, materialParams.camDist1,
               materialParams.camK3_1,
               (idxA == 1) ? coverageA : ((idxB == 1) ? coverageB : ((idxC == 1) ? coverageC : 0.0)),
               rigPos, colorSum, wsum);
        addCam(materialParams_camTex2, materialParams.camRight2, materialParams.camFwd2,
               materialParams.camT2, materialParams.camK2, materialParams.camDist2,
               materialParams.camK3_2,
               (idxA == 2) ? coverageA : ((idxB == 2) ? coverageB : ((idxC == 2) ? coverageC : 0.0)),
               rigPos, colorSum, wsum);
        addCam(materialParams_camTex3, materialParams.camRight3, materialParams.camFwd3,
               materialParams.camT3, materialParams.camK3, materialParams.camDist3,
               materialParams.camK3_3,
               (idxA == 3) ? coverageA : ((idxB == 3) ? coverageB : ((idxC == 3) ? coverageC : 0.0)),
               rigPos, colorSum, wsum);
        addCam(materialParams_camTex4, materialParams.camRight4, materialParams.camFwd4,
               materialParams.camT4, materialParams.camK4, materialParams.camDist4,
               materialParams.camK3_4,
               (idxA == 4) ? coverageA : ((idxB == 4) ? coverageB : ((idxC == 4) ? coverageC : 0.0)),
               rigPos, colorSum, wsum);
        addCam(materialParams_camTex5, materialParams.camRight5, materialParams.camFwd5,
               materialParams.camT5, materialParams.camK5, materialParams.camDist5,
               materialParams.camK3_5,
               (idxA == 5) ? coverageA : ((idxB == 5) ? coverageB : ((idxC == 5) ? coverageC : 0.0)),
               rigPos, colorSum, wsum);

        if (wsum > 0.0) {
            material.baseColor.rgb = (colorSum / wsum) * materialParams.exposureCompensation;
        } else {
            material.baseColor.rgb = materialParams.skyColor;
        }
        material.baseColor.a = 1.0;
    }
}
