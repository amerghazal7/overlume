material {
    name : point_cloud,
    shadingModel : unlit,
    parameters : [
        { type : float, name : alpha },
        { type : float, name : pointSizePx }
    ],
    requires : [ color ],
    blending : fade
}
vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        gl_PointSize = materialParams.pointSizePx;
    }
}
fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        material.baseColor.rgb = getColor().rgb;
        material.baseColor.a = materialParams.alpha;
    }
}
