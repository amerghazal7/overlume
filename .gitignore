__pycache__/
*.pyc
.pytest_cache/
*.egg-info/


# Overlume library + ROS workspace build/install artifacts
ros/build/
ros/install/
ros/log/
*.db*CMakeFiles/
.vscode/
graphify-out/

# Claude Code local-only (do not commit machine/session state)
.claude/settings.local.json
.claude/scheduled_tasks.lock
**/build/
# vcpkg/cesium-native build tree (VM-061 Task 2): **/build/ only matches a
# dir literally named `build`, not `build-cesium/` -- without this the
# fetched cesium-native source drop + Filament tarball under _deps/ would
# get vendored into the repo on the next `git add`.
**/build-*/
**/*.mp4

# VM-044: the converted M02P ego glTF is a provisioned local asset (fetch
# script, not plain git — see micropilot_visualization_node/scripts/
# provision_ego_model.sh), not a repo binary. Narrowed to *.glb so
# assets/ego/ATTRIBUTION.md (same convention as assets/fonts, assets/models)
# can still be committed.
ros/src/micropilot_visualization_node/assets/ego/*.glb
